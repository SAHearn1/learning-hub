# Database (Vercel Postgres / Neon)
# Pooled connection for application queries (used at runtime)
DATABASE_URL="postgresql://user:password@localhost:5432/rootwork?schema=public"
# Direct connection for migrations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/rootwork?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL_PRIMARY=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_LIGHTWEIGHT=claude-3-haiku-20240307

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_STARTER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Error Monitoring (optional — leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Deployment (set in CI/CD secrets, not locally)
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
