# Database (Vercel Postgres / Neon)
# Pooled connection for application queries (used at runtime)
# For serverless (Vercel), append &connection_limit=1 to avoid exhausting pool:
# DATABASE_URL="postgresql://user:password@host:5432/rootwork?schema=public&connection_limit=1&pool_timeout=20"
DATABASE_URL="postgresql://user:password@localhost:5432/rootwork?schema=public"
# Direct connection for migrations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/rootwork?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL_PRIMARY=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_LIGHTWEIGHT=claude-3-haiku-20240307

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_STARTER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx

# Embedding Service (OpenAI — for curriculum RAG)
OPENAI_API_KEY=sk-xxxxx

# Vector Store (Pinecone — for curriculum RAG)
PINECONE_API_KEY=pcsk_xxxxx
PINECONE_INDEX=rootwork-curriculum

# Ingest Webhook (n8n → /api/ingest authentication)
N8N_WEBHOOK_SECRET=whsec_xxxxx

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Privacy / Encryption (REQUIRED in production)
# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. Without this, all chat requests will crash.
DATA_ENCRYPTION_KEY=

# Cron Job Authentication (REQUIRED in production)
# Vercel injects this on cron invocations. Set in Vercel env vars.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Feature Flags
# Set to "false" to allow non-student roles to access student endpoints (dev/testing only)
STRICT_ROLE_ENFORCEMENT=true

# Rate Limiting (optional — defaults shown)
API_RATE_LIMIT_PER_MINUTE=120
TENANT_RATE_LIMIT_PER_MINUTE=200

# Redis Cache (optional — leave blank to disable; app falls back to in-memory)
# For Docker Compose: redis://redis:6379
# For Upstash (serverless): rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Error Monitoring (Sentry — required for production)
# Get your DSN from: https://sentry.io → Settings → Projects → Client Keys
# Without a DSN, all error reporting is silently disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Datadog APM (optional — leave blank to disable)
# Datadog — HTTP API (preferred for Vercel serverless, no agent required)
# Get from: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_METRIC_PREFIX=rootwork

# Datadog — legacy StatsD/UDP (requires a running Datadog Agent, not recommended for serverless)
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=rootwork-tutor
DD_ENV=production
DATADOG_STATSD_HOST=
DATADOG_STATSD_PORT=8125

# Alerting (optional — leave blank to disable channels)
SLACK_WEBHOOK_URL=
PAGERDUTY_SERVICE_KEY=

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Hybrid Search — Supabase + HuggingFace (optional)
# Leave blank to use Pinecone vector-only search (default).
# Set all three to enable BM25+vector hybrid reranking via Supabase pgvector.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HYBRID_RPC=match_documents
# HuggingFace cross-encoder for hybrid search reranking (optional)
HUGGINGFACE_API_KEY=
HUGGINGFACE_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# n8n Workflow Integration
# The URL for your n8n webhook endpoint (e.g., https://your-instance.app.n8n.cloud/webhook/learning-hub-events)
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/learning-hub-events
# Secret key for authenticating webhook requests (generate with: openssl rand -hex 32)
N8N_WEBHOOK_SECRET=your-secret-here

# Deployment (set in CI/CD secrets, not locally)
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
