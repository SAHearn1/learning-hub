enum AiSuggestionDecision {
  ACCEPTED
  REJECTED
  MODIFIED
}

enum AiSuggestionType {
  TUTORING_RESPONSE
  IEP_RECOMMENDATION
  ASSESSMENT_FEEDBACK
  ACCOMMODATION_SUGGESTION
  PROGRESS_NOTE
}

enum AiReviewStatus {
  PENDING_REVIEW
  APPROVED
  APPROVED_WITH_EDITS
  REJECTED
  EXPIRED
}

model AiSuggestionReview {
  id               String           @id @default(cuid())
  tenantId         String
  studentId        String
  sessionId        String?
  suggestionType   AiSuggestionType
  originalContent  String           @db.Text
  editedContent    String?          @db.Text
