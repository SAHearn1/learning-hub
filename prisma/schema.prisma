  @@index([tenantId])
  @@index([studentId])
  @@index([deletedAt])
}

model Message {
  id                    String                 @id @default(cuid())
  sessionId             String
  session               Session                @relation(fields: [sessionId], references: [id])
  role                  MessageRole
  content               String                 @db.Text
  metadata              Json?
  createdAt             DateTime               @default(now())
