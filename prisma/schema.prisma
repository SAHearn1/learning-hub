}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Subject {
  MATH
  SCIENCE
  LANGUAGE_ARTS
  FINANCIAL_LITERACY
}

enum FiveRPhase {
  ROOT
  REGULATE
  REFLECT
  RESTORE
  RECONNECT
