// RootWork AI Tutoring Platform — Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// MULTI-TENANCY MODELS
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  domain               String?
  subscriptionTier     SubscriptionTier   @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  isSuspended          Boolean            @default(false)
  suspendedAt          DateTime?
  suspensionReason     String?
  settings             Json               @default("{}")
  schools              School[]
  users                User[]
  aiUsageLedger        AIUsageLedger[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model School {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  address    String?
  gradeRange Int[]
  settings   Json     @default("{}")
  classes    Class[]
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model Class {
  id           String            @id @default(cuid())
  tenantId     String
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id])
  name         String
  subject      Subject
  gradeLevel   Int
  academicYear String
  educatorId   String
  educator     User              @relation("ClassEducator", fields: [educatorId], references: [id])
  enrollments  ClassEnrollment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId])
  @@index([schoolId])
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  tenantId   String
  classId    String
  class      Class            @relation(fields: [classId], references: [id])
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)

  @@unique([classId, studentId])
  @@index([tenantId])
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

// ═══════════════════════════════════════════════════════════════
// USER & ROLE MODELS
// ═══════════════════════════════════════════════════════════════

model User {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id])
  clerkUserId     String         @unique
  email           String
  firstName       String
  lastName        String
  role            UserRole
  dateOfBirth     DateTime?
  isMinor         Boolean        @default(false)
  consentStatus   ConsentStatus?
  consentRecordId String?
  student         Student?
  educator        Educator?
  parent          Parent?
  teachingClasses Class[]        @relation("ClassEducator")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([clerkUserId])
}

enum UserRole {
  STUDENT
  EDUCATOR
  PARENT
  SCHOOL_ADMIN
  DISTRICT_ADMIN
  PLATFORM_ADMIN
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  WITHDRAWN
}

// ═══════════════════════════════════════════════════════════════
// STUDENT MODEL
// ═══════════════════════════════════════════════════════════════

model Student {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id])
  gradeLevel          Int
  learningPreferences Json
  regulationProfile   Json
  iepAccommodations   IepAccommodation[]
  sessions            Session[]
  progress            Progress[]
  enrollments         ClassEnrollment[]
  thinkingProgress    ReasoningMoveProgress[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model Educator {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  certifications  String[]
  specializations String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Parent {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  childrenIds        String[]
  communicationPrefs Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// IEP ACCOMMODATIONS
// ═══════════════════════════════════════════════════════════════

model IepAccommodation {
  id          String            @id @default(cuid())
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id])
  type        AccommodationType
  description String
  parameters  Json
  active      Boolean           @default(true)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([studentId])
}

enum AccommodationType {
  EXTENDED_TIME
  REDUCED_STIMULI
  SIMPLIFIED_MODE
  TEXT_TO_SPEECH
  FREQUENT_BREAKS
  CHUNKED_CONTENT
  MODIFIED_DIFFICULTY
  VISUAL_SUPPORTS
  AUDIO_SUPPORTS
  ALTERNATIVE_ASSESSMENT
}

// ═══════════════════════════════════════════════════════════════
// SESSION & MESSAGE MODELS
// ═══════════════════════════════════════════════════════════════

model Session {
  id                  String               @id @default(cuid())
  tenantId            String
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id])
  subject             Subject
  currentPhase        FiveRPhase
  regulationState     Json
  engagementMode      EngagementMode       @default(FORWARD)
  messages            Message[]
  assessments         Assessment[]
  thinkingAssessments ThinkingAssessment[]
  startedAt           DateTime             @default(now())
  endedAt             DateTime?
  metadata            Json

  @@index([tenantId])
  @@index([studentId])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Subject {
  MATH
  SCIENCE
  LANGUAGE_ARTS
}

enum FiveRPhase {
  ROOT
  REGULATE
  REFLECT
  RESTORE
  RECONNECT
}

// ═══════════════════════════════════════════════════════════════
// ASSESSMENT & PROGRESS MODELS
// ═══════════════════════════════════════════════════════════════

model Assessment {
  id              String         @id @default(cuid())
  sessionId       String
  session         Session        @relation(fields: [sessionId], references: [id])
  standardId      String?
  standard        Standard?      @relation(fields: [standardId], references: [id])
  type            AssessmentType
  bloomsLevel     BloomsLevel
  difficulty      Int
  question        String         @db.Text
  studentResponse String?        @db.Text
  isCorrect       Boolean?
  score           Float?
  feedback        String?        @db.Text
  metadata        Json?
  createdAt       DateTime       @default(now())
}

enum AssessmentType {
  DIAGNOSTIC
  FORMATIVE
  SUMMATIVE
  PRACTICE
}

enum BloomsLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

model Progress {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  standardId      String
  standard        Standard  @relation(fields: [standardId], references: [id])
  masteryLevel    Float
  assessmentCount Int       @default(0)
  lastAssessedAt  DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, standardId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// THINKING ASSESSMENT MODELS
// ═══════════════════════════════════════════════════════════════

model ThinkingAssessment {
  id                      String                 @id @default(cuid())
  sessionId               String
  session                 Session                @relation(fields: [sessionId], references: [id])
  assessmentType          ThinkingAssessmentType
  reasoningArticulation   Int?
  assumptionAwareness     Int?
  evidenceEvaluation      Int?
  alternativePerspectives Int?
  conclusionJustification Int?
  metacognitiveAwareness  Int?
  fluency                 Int?
  flexibility             Int?
  originality             Int?
  elaboration             Int?
  riskTaking              Int?
  modeUsed                EngagementMode
  reasoningMovesUsed      String[]
  traceProtocolEvidence   Json?
  rawResponse             String                 @db.Text
  aiAnalysis              String?                @db.Text
  createdAt               DateTime               @default(now())
}

enum ThinkingAssessmentType {
  REASONING_RECONSTRUCTION
  ERROR_DETECTION
  MULTIPLE_PATHWAYS
  PROBLEM_CREATION
  INTEGRATED
}

enum EngagementMode {
  FORWARD
  REVERSE
  ERROR_ANALYSIS
  MULTIPLE_PATHWAYS
  PROBLEM_POSING
}

model ReasoningMoveProgress {
  id               String        @id @default(cuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  move             ReasoningMove
  introducedAt     DateTime
  usageCount       Int           @default(0)
  promptedUsage    Int           @default(0)
  spontaneousUsage Int           @default(0)
  proficiencyLevel Int           @default(1)
  updatedAt        DateTime      @updatedAt

  @@unique([studentId, move])
}

enum ReasoningMove {
  DECOMPOSE
  IDENTIFY
  COMPARE
  CLASSIFY
  SEQUENCE
  CAUSE_EFFECT
  QUESTION
  CHALLENGE
  VERIFY
  JUSTIFY
  CRITIQUE
  WEIGH
  HYPOTHESIZE
  CONNECT
  GENERALIZE
  SPECIALIZE
  TRANSFORM
  CREATE
  MONITOR
  ADJUST
  REFLECT
  PLAN
}

// ═══════════════════════════════════════════════════════════════
// CURRICULUM MODELS
// ═══════════════════════════════════════════════════════════════

model Standard {
  id            String            @id @default(cuid())
  code          String            @unique
  framework     StandardFramework
  subject       Subject
  gradeLevel    Int[]
  domain        String
  cluster       String
  description   String            @db.Text
  fullText      String            @db.Text
  prerequisites Standard[]        @relation("Prerequisites")
  dependents    Standard[]        @relation("Prerequisites")
  topics        Topic[]
  assessments   Assessment[]
  progress      Progress[]
  embedding     Bytes?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum StandardFramework {
  GEORGIA
  COMMON_CORE
  NGSS
}

model Topic {
  id                      String              @id @default(cuid())
  name                    String
  subject                 Subject
  gradeLevel              Int[]
  description             String              @db.Text
  standards               Standard[]
  prerequisites           Topic[]             @relation("TopicPrerequisites")
  dependents              Topic[]             @relation("TopicPrerequisites")
  learningObjectives      LearningObjective[]
  problems                Problem[]
  conceptualUnderstanding String              @db.Text
  commonMisconceptions    String[]
  realWorldConnections    String[]
  estimatedDuration       Int
  embedding               Bytes?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model LearningObjective {
  id          String      @id @default(cuid())
  topicId     String
  topic       Topic       @relation(fields: [topicId], references: [id])
  description String      @db.Text
  bloomsLevel BloomsLevel
  measurable  Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

model Problem {
  id            String      @id @default(cuid())
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id])
  stem          String      @db.Text
  scaffold      Json
  solutionPaths Json
  commonErrors  Json
  rubric        Json
  gardenContext String?     @db.Text
  difficulty    Int
  bloomsLevel   BloomsLevel
  type          ProblemType
  validated     Boolean     @default(false)
  embedding     Bytes?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum ProblemType {
  PRACTICE
  DIAGNOSTIC
  CHALLENGE
  REAL_WORLD
  CROSS_CURRICULAR
}

// ═══════════════════════════════════════════════════════════════
// AI USAGE TRACKING
// ════════════════════���══════════════════════════════════════════

model AIUsageLedger {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  sessionId     String?
  userId        String
  requestType   AIRequestType
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  costUSD       Decimal       @db.Decimal(10, 6)
  latencyMs     Int
  success       Boolean
  errorType     String?
  feature       AIFeature
  subject       Subject?
  timestamp     DateTime      @default(now())

  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@index([sessionId])
}

enum AIRequestType {
  TUTOR_CONVERSATION
  ASSESSMENT_GENERATION
  FEEDBACK_GENERATION
  REGULATION_DETECTION
  THINKING_ANALYSIS
  REPORT_GENERATION
  EMBEDDING_GENERATION
}

enum AIFeature {
  CORE_TUTORING
  ADAPTIVE_ASSESSMENT
  REVERSE_ENGINEERING
  ERROR_ANALYSIS
  PROBLEM_POSING
  REGULATION_SUPPORT
  REPORT_GENERATION
}

// ═══════════════════════════════════════════════════════════════
// AUDIT & COMPLIANCE
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  action       String
  resource     String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  previousHash String?
  chainHash    String   @unique
  timestamp    DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// CURRICULUM INGESTION TRACKING
// ═══════════════════════════════════════════════════════════════

model IngestLog {
  id               String       @id @default(cuid())
  timestamp        DateTime     @default(now())
  status           IngestStatus
  source           IngestSource
  payload          Json?
  errorMessage     String?      @db.Text
  processedFiles   Int          @default(0)
  durationMs       Int?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([timestamp])
  @@index([status])
  @@index([source])
}

enum IngestStatus {
  PENDING
  SUCCESS
  FAILURE
  PROCESSING
}

enum IngestSource {
  WEBHOOK
  MANUAL
  SCHEDULED
  API
}
