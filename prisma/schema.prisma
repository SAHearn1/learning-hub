// RootWork AI Tutoring Platform — Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// MULTI-TENANCY MODELS
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  domain               String?
  subscriptionTier     SubscriptionTier   @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  isSuspended          Boolean            @default(false)
  suspendedAt          DateTime?
  suspensionReason     String?
  settings             Json               @default("{}")
  schools              School[]
  users                User[]
  aiUsageLedger        AIUsageLedger[]
  aiSuggestionReviews  AiSuggestionReview[]
  proceduralEvents     ProceduralEvent[]
  safeguardsNotices    SafeguardsNotice[]
  iepGoals             IepGoal[]
  goalProgressEntries  GoalProgressEntry[]
  progressReports      ProgressReport[]
  evaluationCases      EvaluationCase[]
  disciplineCases      DisciplineCase[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model School {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  address    String?
  gradeRange Int[]
  settings   Json     @default("{}")
  classes    Class[]
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model Term {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  classes      Class[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Course {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?  @db.Text
  subject     Subject
  gradeLevel  Int[]
  classes     Class[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Class {
  id           String            @id @default(cuid())
  tenantId     String
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id])
  courseId      String?
  course       Course?           @relation(fields: [courseId], references: [id])
  termId       String?
  term         Term?             @relation(fields: [termId], references: [id])
  name         String
  subject      Subject
  gradeLevel   Int
  academicYear String
  educatorId   String
  educator     User              @relation("ClassEducator", fields: [educatorId], references: [id])
  enrollments  ClassEnrollment[]
  assignments  Assignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId])
  @@index([schoolId])
  @@index([courseId])
  @@index([termId])
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  tenantId   String
  classId    String
  class      Class            @relation(fields: [classId], references: [id])
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)

  @@unique([classId, studentId])
  @@index([tenantId])
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

// ═══════════════════════════════════════════════════════════════
// LMS CORE MODELS (Course Delivery)
// ═══════════════════════════════════════════════════════════════

model Assignment {
  id          String           @id @default(cuid())
  tenantId    String
  classId     String
  class       Class            @relation(fields: [classId], references: [id])
  createdById String
  createdBy   User             @relation("AssignmentCreator", fields: [createdById], references: [id])
  title       String
  description String?          @db.Text
  type        AssignmentType   @default(HOMEWORK)
  dueDate     DateTime?
  points      Int              @default(100)
  rubric      Json?
  published   Boolean          @default(false)
  templateId  String?
  template    FiveRTemplate?   @relation(fields: [templateId], references: [id])
  submissions Submission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@index([classId])
  @@index([classId, dueDate])
  @@index([templateId])
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  TEST
  PROJECT
  DISCUSSION
  FIVE_R_SESSION
}

model Submission {
  id           String           @id @default(cuid())
  tenantId     String
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  content      String?          @db.Text
  attachments  Json?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  grade        Grade?
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([studentId])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  GRADED
}

model Grade {
  id           String     @id @default(cuid())
  tenantId     String
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id])
  gradedById   String
  gradedBy     User       @relation("GradeGrader", fields: [gradedById], references: [id])
  score        Float
  maxScore     Float      @default(100)
  percentage   Float
  letterGrade  String?
  feedback     String?    @db.Text
  rubricScores Json?
  gradedAt     DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId])
  @@index([submissionId])
}

// ═══════════════════════════════════════════════════════════════
// USER & ROLE MODELS
// ═══════════════════════════════════════════════════════════════

model User {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id])
  clerkUserId     String         @unique
  email           String
  firstName       String
  lastName        String
  role            UserRole
  dateOfBirth     DateTime?
  isMinor         Boolean        @default(false)
  consentStatus    ConsentStatus?
  consentRecordId  String?
  consentGrantedAt   DateTime?
  consentArchived    Boolean        @default(false)
  consentArchivedAt  DateTime?
  student         Student?
  educator        Educator?
  parent          Parent?
  teachingClasses      Class[]        @relation("ClassEducator")
  createdAssignments   Assignment[]   @relation("AssignmentCreator")
  createdTemplates     FiveRTemplate[] @relation("TemplateCreator")
  gradedSubmissions    Grade[]        @relation("GradeGrader")
  educatorReviews      AiSuggestionReview[] @relation("EducatorReviews")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([tenantId])
  @@index([clerkUserId])
}

enum UserRole {
  STUDENT
  EDUCATOR
  PARENT
  SCHOOL_ADMIN
  DISTRICT_ADMIN
  PLATFORM_ADMIN
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  WITHDRAWN
}

// ═══════════════════════════════════════════════════════════════
// STUDENT MODEL
// ═══════════════════════════════════════════════════════════════

model Student {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id])
  gradeLevel          Int
  learningPreferences Json
  regulationProfile   Json
  iepAccommodations   IepAccommodation[]
  iepGoals            IepGoal[]
  goalProgressEntries GoalProgressEntry[]
  progressReports     ProgressReport[]
  evaluationCases     EvaluationCase[]
  disciplineCases     DisciplineCase[]
  proceduralEvents    ProceduralEvent[]
  safeguardsNotices   SafeguardsNotice[]
  sessions            Session[]
  progress            Progress[]
  enrollments         ClassEnrollment[]
  submissions         Submission[]
  thinkingProgress    ReasoningMoveProgress[]
  abilityEstimates    StudentAbility[]
  reviewSchedules     ReviewSchedule[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model Educator {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  certifications  String[]
  specializations String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Parent {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  childrenIds        String[]
  communicationPrefs Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// IEP ACCOMMODATIONS
// ═══════════════════════════════════════════════════════════════

model IepAccommodation {
  id          String            @id @default(cuid())
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id])
  type        AccommodationType
  description String
  parameters  Json
  active      Boolean           @default(true)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([studentId])
}

enum AccommodationType {
  EXTENDED_TIME
  REDUCED_STIMULI
  SIMPLIFIED_MODE
  TEXT_TO_SPEECH
  FREQUENT_BREAKS
  CHUNKED_CONTENT
  MODIFIED_DIFFICULTY
  VISUAL_SUPPORTS
  AUDIO_SUPPORTS
  ALTERNATIVE_ASSESSMENT
}

// ═══════════════════════════════════════════════════════════════
// IDEA PROCEDURAL SAFEGUARDS (34 CFR §300.504)
// ═══════════════════════════════════════════════════════════════

enum SafeguardsTrigger {
  ANNUAL_NOTICE
  INITIAL_REFERRAL_OR_PARENT_EVAL_REQUEST
  FIRST_STATE_COMPLAINT_IN_SCHOOL_YEAR
  FIRST_DUE_PROCESS_COMPLAINT_IN_SCHOOL_YEAR
  DISCIPLINARY_CHANGE_OF_PLACEMENT
  PARENT_REQUEST
}

enum ProceduralEventType {
  REFERRAL_RECEIVED
  PARENT_EVAL_REQUEST
  STATE_COMPLAINT_FILED
  DUE_PROCESS_COMPLAINT_FILED
  DISCIPLINARY_PLACEMENT_CHANGE
  PARENT_SAFEGUARDS_REQUEST
  ANNUAL_NOTICE_DUE
}

enum DeliveryMethod {
  PORTAL
  EMAIL
  MAIL
  HAND_DELIVERED
}

enum DeliveryStatus {
  PENDING
  GENERATED
  DELIVERED
  ACKNOWLEDGED
  FAILED
}

model ProceduralEvent {
  id              String              @id @default(cuid())
  tenantId        String
  studentId       String
  caseId          String?
  eventType       ProceduralEventType
  trigger         SafeguardsTrigger
  schoolYear      String
  correlationId   String
  isFirstOfType   Boolean             @default(false)
  metadata        Json?
  createdBy       String
  createdAt       DateTime            @default(now())

  notices         SafeguardsNotice[]
  student         Student             @relation(fields: [studentId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, correlationId])
  @@unique([tenantId, studentId, schoolYear, eventType, isFirstOfType])
  @@index([tenantId, studentId, schoolYear])
  @@index([caseId])
}

model SafeguardsNotice {
  id                 String            @id @default(cuid())
  tenantId           String
  studentId          String
  caseId             String?
  proceduralEventId  String
  trigger            SafeguardsTrigger
  deliveryMethod     DeliveryMethod    @default(PORTAL)
  deliveryStatus     DeliveryStatus    @default(PENDING)
  deliveredAt        DateTime?
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  noticeDocHash      String
  artifactRef        String
  schoolYear         String
  createdAt          DateTime          @default(now())

  proceduralEvent    ProceduralEvent   @relation(fields: [proceduralEventId], references: [id])
  student            Student           @relation(fields: [studentId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId, schoolYear])
  @@index([caseId])
  @@index([proceduralEventId])
  @@index([deliveryStatus])
}

// ═══════════════════════════════════════════════════════════════
// IDEA PROGRESS MONITORING (34 CFR §300.320(a)(3))
// ═══════════════════════════════════════════════════════════════

enum IepGoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum MeasurementMethod {
  CURRICULUM_BASED
  OBSERVATION
  RUBRIC
  STANDARDIZED_ASSESSMENT
  WORK_SAMPLE
  DATA_COLLECTION
}

enum ReportingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  TRIMESTER
  SEMESTER
}

enum ProgressReportDelivery {
  PENDING
  GENERATED
  DELIVERED
  ACKNOWLEDGED
  FAILED
}

model IepGoal {
  id                    String              @id @default(cuid())
  tenantId              String
  studentId             String
  goalCode              String
  description           String              @db.Text
  baselineValue         Float
  baselineDate          DateTime
  targetValue           Float
  targetDate            DateTime
  measurementMethod     MeasurementMethod?
  measurementUnit       String?
  reportingFrequency    ReportingFrequency?
  monitoringIntervalDays Int                @default(30)
  status                IepGoalStatus       @default(DRAFT)
  activatedAt           DateTime?
  completedAt           DateTime?
  createdBy             String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  entries               GoalProgressEntry[]
  reports               ProgressReport[]
  student               Student             @relation(fields: [studentId], references: [id])
  tenant                Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, goalCode])
  @@index([tenantId, studentId])
}

model GoalProgressEntry {
  id                String   @id @default(cuid())
  tenantId          String
  goalId            String
  studentId         String
  recordedValue     Float
  measurementMethod MeasurementMethod
  observationDate   DateTime
  notes             String?  @db.Text
  entryHash         String
  recordedBy        String
  createdAt         DateTime @default(now())

  goal              IepGoal  @relation(fields: [goalId], references: [id])
  student           Student  @relation(fields: [studentId], references: [id])
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([goalId, observationDate])
  @@index([tenantId])
}

model ProgressReport {
  id                   String                  @id @default(cuid())
  tenantId             String
  goalId               String
  studentId            String
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  entryCount           Int
  currentValue         Float
  baselineValue        Float
  targetValue          Float
  trendDirection       String
  trendSlope           Float?
  reportContent        String                  @db.Text
  reportHash           String
  artifactRef          String
  deliveryStatus       ProgressReportDelivery  @default(PENDING)
  deliveredAt          DateTime?
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  generatedBy          String
  createdAt            DateTime                @default(now())

  goal                 IepGoal                 @relation(fields: [goalId], references: [id])
  student              Student                 @relation(fields: [studentId], references: [id])
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([goalId, createdAt])
  @@index([deliveryStatus])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// IDEA EVALUATION GOVERNANCE (34 CFR §300.300–§300.311)
// ═══════════════════════════════════════════════════════════════

enum EvalCaseState {
  EVAL_TRIGGERED
  SAFEGUARDS_ISSUED
  SAFEGUARDS_REQUIRED
  CONSENT_REQUESTED
  CONSENT_RECEIVED
  CONSENT_REFUSED
  EVALUATION_PLANNED
  ASSESSMENTS_IN_PROGRESS
  ASSESSMENTS_COMPLETE
  ELIGIBILITY_MEETING
  ELIGIBILITY_DECISION
  CLOSED
}

enum EvalCaseType {
  INITIAL
  REEVALUATION
  DISMISSAL
}

enum ConsentType {
  INITIAL_EVALUATION
  REEVALUATION
  SERVICES
  RELEASE_OF_RECORDS
}

enum ConsentDecision {
  GRANTED
  REFUSED
  REVOKED
}

enum EligibilityOutcome {
  ELIGIBLE
  NOT_ELIGIBLE
  DISMISSED
}

enum AssessmentDomain {
  ACADEMIC_ACHIEVEMENT
  COGNITIVE
  COMMUNICATION
  SOCIAL_EMOTIONAL
  ADAPTIVE_BEHAVIOR
  MOTOR
  HEALTH
  VISION
  HEARING
  ASSISTIVE_TECHNOLOGY
  TRANSITION
  FUNCTIONAL_BEHAVIOR
  VOCATIONAL
  OTHER
}

enum TimelineUnit {
  CALENDAR_DAYS
  SCHOOL_DAYS
}

model EvaluationCase {
  id                   String               @id @default(cuid())
  tenantId             String
  studentId            String
  caseType             EvalCaseType
  currentState         EvalCaseState        @default(EVAL_TRIGGERED)
  stateCode            String               @default("US")
  referralSource       String?
  referralReason       String?              @db.Text
  referralDate         DateTime?
  consentRequestedDate DateTime?
  consentReceivedDate  DateTime?
  evaluationDueDate    DateTime?
  eligibilityDate      DateTime?
  closedDate           DateTime?
  closedReason         String?
  correlationId        String               @unique
  metadata             Json?
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  transitions          EvalStateTransition[]
  plan                 EvaluationPlan?
  assignments          EvaluationAssignment[]
  assessments          EvalAssessmentRecord[]
  consents             EvalConsentRecord[]
  eligibilityMeeting   EligibilityMeeting?
  eligibilityDecision  EligibilityDecision?
  student              Student              @relation(fields: [studentId], references: [id])
  tenant               Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId, currentState])
  @@index([evaluationDueDate])
  @@index([tenantId, studentId])
}

model EvalStateTransition {
  id             String   @id @default(cuid())
  tenantId       String
  caseId         String
  fromState      String
  toState        String
  transitionBy   String
  reason         String?  @db.Text
  ruleResults    Json?
  transitionHash String
  createdAt      DateTime @default(now())

  evaluationCase EvaluationCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@index([tenantId])
}

model EvaluationPlan {
  id                String   @id @default(cuid())
  tenantId          String
  caseId            String   @unique
  assessmentDomains Json
  planContent       String   @db.Text
  planHash          String
  artifactRef       String
  createdBy         String
  createdAt         DateTime @default(now())

  evaluationCase    EvaluationCase @relation(fields: [caseId], references: [id])

  @@index([tenantId])
}

model EvaluationAssignment {
  id             String    @id @default(cuid())
  tenantId       String
  caseId         String
  assessorId     String
  domain         AssessmentDomain
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  evaluationCase EvaluationCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([tenantId])
}

model EvalAssessmentRecord {
  id               String   @id @default(cuid())
  tenantId         String
  caseId           String
  assignmentId     String?
  domain           AssessmentDomain
  instrumentName   String
  administeredBy   String
  administeredDate DateTime
  results          Json
  narrative        String?  @db.Text
  reportHash       String
  artifactRef      String
  createdAt        DateTime @default(now())

  evaluationCase   EvaluationCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([tenantId])
}

model EvalConsentRecord {
  id             String          @id @default(cuid())
  tenantId       String
  caseId         String
  consentType    ConsentType
  decision       ConsentDecision
  respondentId   String
  respondentName String
  consentDate    DateTime
  documentHash   String
  artifactRef    String
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())

  evaluationCase EvaluationCase  @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([tenantId])
}

model EligibilityMeeting {
  id             String         @id @default(cuid())
  tenantId       String
  caseId         String         @unique
  scheduledDate  DateTime
  actualDate     DateTime?
  attendees      Json
  requiredRoles  String[]
  meetingNotes   String?        @db.Text
  meetingHash    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  evaluationCase EvaluationCase @relation(fields: [caseId], references: [id])

  @@index([tenantId])
}

model EligibilityDecision {
  id                 String            @id @default(cuid())
  tenantId           String
  caseId             String            @unique
  outcome            EligibilityOutcome
  disabilityCategory String?
  rationale          String            @db.Text
  decisionDate       DateTime
  decisionHash       String
  artifactRef        String
  decidedBy          String
  createdAt          DateTime          @default(now())

  evaluationCase     EvaluationCase    @relation(fields: [caseId], references: [id])

  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// DISCIPLINE PROTECTIONS (34 CFR §300.530–§300.536)
// ═══════════════════════════════════════════════════════════════

enum DisciplineCaseState {
  REMOVAL_RECORDED
  THRESHOLD_REVIEW
  MDR_PENDING
  MDR_COMPLETE
  PLACEMENT_DETERMINED
  SERVICES_IN_PROGRESS
  CLOSED
}

enum RemovalType {
  IN_SCHOOL_SUSPENSION
  OUT_OF_SCHOOL_SUSPENSION
  EXPULSION
  BUS_SUSPENSION
  OTHER
}

enum ManifestOutcome {
  IS_MANIFESTATION
  NOT_MANIFESTATION
}

enum PlacementType {
  RETURN_TO_PLACEMENT
  IAES
  ALTERNATIVE_SETTING
  HOME_INSTRUCTION
}

model DisciplineCase {
  id                      String               @id @default(cuid())
  tenantId                String
  studentId               String
  currentState            DisciplineCaseState   @default(REMOVAL_RECORDED)
  removalType             RemovalType
  removalStartDate        DateTime
  removalEndDate          DateTime?
  removalDays             Int
  cumulativeRemovalDays   Int                   @default(0)
  isChangeOfPlacement     Boolean               @default(false)
  currentPlacement        PlacementType?
  iaesEndDate             DateTime?
  servicesDescription     String?               @db.Text
  servicesContinued       Boolean               @default(false)
  incidentDescription     String                @db.Text
  closedDate              DateTime?
  closedReason            String?
  metadata                Json?
  createdBy               String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  manifestDetermination   ManifestDetermination?
  student                 Student               @relation(fields: [studentId], references: [id])
  tenant                  Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, currentState])
  @@index([tenantId, studentId])
  @@index([removalStartDate])
}

model ManifestDetermination {
  id                  String           @id @default(cuid())
  tenantId            String
  caseId              String           @unique
  meetingDate         DateTime
  attendees           Json
  outcome             ManifestOutcome
  rationale           String           @db.Text
  conductRelated      Boolean
  disabilityRelated   Boolean
  iepImplemented      Boolean
  documentHash        String
  artifactRef         String
  decidedBy           String
  createdAt           DateTime         @default(now())

  disciplineCase      DisciplineCase   @relation(fields: [caseId], references: [id])

  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// ITEM RESPONSE THEORY (IRT) MODELS
// ═══════════════════════════════════════════════════════════════

model ItemCalibration {
  id                String      @id @default(cuid())
  assessmentId      String?     @unique
  assessment        Assessment? @relation(fields: [assessmentId], references: [id])
  problemId         String?     @unique
  problem           Problem?    @relation(fields: [problemId], references: [id])
  itemType          ItemType    @default(ASSESSMENT)
  irtDifficulty     Float // b parameter (-3 to +3 logit scale)
  irtDiscrimination Float       @default(1.0) // a parameter (0 to 2.5+)
  irtGuessing       Float       @default(0.0) // c parameter for 3PL (0 to 0.5)
  calibrationModel  IRTModel    @default(TWO_PL)
  sampleSize        Int         @default(0) // responses used for calibration
  standardError     Float?
  itemInformation   Float? // peak information value
  reliabilityIndex  Float? // 0 to 1
  lastCalibratedAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([irtDifficulty])
  @@index([itemType])
}

enum ItemType {
  ASSESSMENT
  PROBLEM
}

enum IRTModel {
  ONE_PL // Rasch model
  TWO_PL // 2-parameter logistic
  THREE_PL // 3-parameter logistic
}

model StudentAbility {
  id                      String   @id @default(cuid())
  studentId               String
  student                 Student  @relation(fields: [studentId], references: [id])
  subject                 Subject
  currentTheta            Float // ability estimate (-3 to +3 logit scale)
  standardError           Float
  confidenceIntervalLower Float
  confidenceIntervalUpper Float
  reliabilityIndex        Float // 0 to 1
  assessmentCount         Int      @default(0)
  lastEstimatedAt         DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([studentId, subject])
  @@index([studentId])
  @@index([subject])
}

model ResponseData {
  id                   String     @id @default(cuid())
  assessmentId         String
  assessment           Assessment @relation(fields: [assessmentId], references: [id])
  studentId            String
  itemCalibrationId    String?
  isCorrect            Boolean
  responseTime         Int? // milliseconds
  probabilityPredicted Float? // from ICC
  residual             Float? // observed - predicted
  studentTheta         Float? // theta at time of response
  createdAt            DateTime   @default(now())

  @@index([assessmentId])
  @@index([studentId])
  @@index([itemCalibrationId])
}

// ═══════════════════════════════════════════════════════════════
// SPACED REPETITION SYSTEM (SRS) MODELS - FSRS Algorithm
// ═══════════════════════════════════════════════════════════════

model ReviewSchedule {
  id             String          @id @default(cuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id])
  conceptType    ConceptType
  standardId     String?
  standard       Standard?       @relation(fields: [standardId], references: [id])
  topicId        String?
  topic          Topic?          @relation(fields: [topicId], references: [id])
  problemId      String?
  problem        Problem?        @relation(fields: [problemId], references: [id])
  state          ReviewState     @default(NEW)
  stability      Float           @default(0.0) // FSRS: memory stability (days)
  difficulty     Float           @default(5.0) // FSRS: item difficulty (0-10)
  elapsedDays    Int             @default(0)
  scheduledDays  Int             @default(0)
  dueDate        DateTime
  lastReviewDate DateTime?
  lapses         Int             @default(0) // times forgotten
  reps           Int             @default(0) // total reviews
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reviewHistory  ReviewHistory[]

  @@unique([studentId, conceptType, standardId, topicId, problemId])
  @@index([studentId])
  @@index([studentId, dueDate])
  @@index([dueDate])
  @@index([state])
}

enum ConceptType {
  STANDARD
  TOPIC
  PROBLEM
}

enum ReviewState {
  NEW // Never reviewed
  LEARNING // In initial learning phase
  REVIEW // In review phase
  RELEARNING // Forgotten, being relearned
}

model ReviewHistory {
  id                 String         @id @default(cuid())
  scheduleId         String
  schedule           ReviewSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  rating             ReviewRating
  state              ReviewState
  reviewedAt         DateTime       @default(now())
  elapsedDays        Int
  scheduledDays      Int
  previousStability  Float
  newStability       Float
  previousDifficulty Float
  newDifficulty      Float
  responseTime       Int? // milliseconds
  createdAt          DateTime       @default(now())

  @@index([scheduleId])
  @@index([reviewedAt])
}

enum ReviewRating {
  AGAIN // Completely forgot (1)
  HARD // Remembered with difficulty (2)
  GOOD // Remembered correctly (3)
  EASY // Remembered easily (4)
}

// ═══════════════════════════════════════════════════════════════
// SESSION & MESSAGE MODELS
// ═══════════════════════════════════════════════════════════════

model Session {
  id                  String               @id @default(cuid())
  tenantId            String
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id])
  subject             Subject
  currentPhase        FiveRPhase
